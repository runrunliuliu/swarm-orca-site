---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateLabel, url, imageSet } from '../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('research')).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'research'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(heading => heading.depth === 2);
---
<Base title={post.data.title} description={post.data.description} image={post.data.image} article>
  <article class="shell article-page">
    <header class="article-heading">
      <a class="back-link" href={url('research/')}>← 研究文章</a>
      <div class="meta">{post.data.category}{post.data.sample && <span>示例文章</span>}</div>
      <h1>{post.data.title}</h1><p class="dek">{post.data.description}</p>
      <div class="byline"><span>{post.data.author}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>约 {post.data.minutes} 分钟</span></div>
    </header>
    <figure class="article-cover"><img src={url(post.data.image)} srcset={imageSet(post.data.image)} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1400px) 90vw, 1280px" alt={post.data.imageAlt} width="1600" height="900" fetchpriority="high" /><figcaption>{post.data.caption}</figcaption></figure>
    <div class="article-grid">
      <aside class="toc" aria-label="文章目录"><details open><summary>本文目录</summary><nav aria-label="章节导航">{sections.map(section => <a href={`#${section.slug}`}>{section.text}</a>)}</nav></details></aside>
      <div class="prose">
        {post.data.sample && <aside class="editor-note"><strong>阅读前说明</strong><p>这是一篇用于验证网站排版的示例文章，内容待审核。文中的概念图解不是运行记录，也不代表功能已完成验收。</p></aside>}
        <Content />
        <div class="article-end"><p>下一篇文章，从一个可复现的问题开始。</p><a class="text-link" href={url('research/')}>研究文章 <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </article>
  <script>
    const toc = document.querySelector<HTMLDetailsElement>('.toc details');
    if (toc && window.matchMedia('(max-width: 1023px)').matches) toc.open = false;
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc nav a')];
    const observer = new IntersectionObserver(entries => {
      const entry = entries.find(item => item.isIntersecting);
      if (!entry) return;
      links.forEach(link => {
        const active = decodeURIComponent(link.hash.slice(1)) === entry.target.id;
        if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      });
    }, { rootMargin: '-5% 0px -65% 0px' });
    document.querySelectorAll('.prose h2').forEach(heading => observer.observe(heading));
  </script>
</Base>
