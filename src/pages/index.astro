---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { dateLabel, url, imageSet } from '../lib/site';
const posts = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, second] = posts;
---
<Base>
  <section class="home-intro shell">
    <p class="eyebrow">Swarm-Orca / 研究与工程</p>
    <h1>让多 Agent 协作，<br />成为可验证的工程。</h1>
    <p class="intro-text">记录任务编排、协作边界与可靠交付背后的设计思考。</p>
    <a class="text-link" href={url('research/')}>研究文章 <span aria-hidden="true">↗</span></a>
  </section>
  <section class="featured shell" aria-labelledby="featured-title">
    <a class="featured-image" href={url(`research/${featured.id}/`)} tabindex="-1" aria-hidden="true">
      <img src={url(featured.data.image)} srcset={imageSet(featured.data.image)} sizes="(max-width: 767px) calc(100vw - 40px), 55vw" alt="" width="1600" height="900" fetchpriority="high" />
    </a>
    <div class="featured-copy">
      <div class="meta">{featured.data.category}<span>示例文章</span></div>
      <h2 id="featured-title"><a href={url(`research/${featured.id}/`)}>{featured.data.title}</a></h2>
      <p>{featured.data.description}</p>
      <div class="meta"><time datetime={featured.data.date.toISOString()}>{dateLabel(featured.data.date)}</time><span>约 {featured.data.minutes} 分钟</span></div>
      <a class="text-link" href={url(`research/${featured.id}/`)}>阅读全文 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="perspectives shell" aria-labelledby="perspectives-title">
    <div class="perspective-intro">
      <h2 id="perspectives-title">从“能执行”<br />到“能交付”。</h2>
      <p>多开几个 Agent 只是起点。我们更关心，协作过程能否被理解，结果能否被检查。</p>
      <a class="text-link" href={url('about/')}>关于项目 <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="questions">
      <div><dt>任务有自己的上下文</dt><dd>围绕任务组织工作区、执行记录与产物，让一次协作有可追溯的边界。</dd></div>
      <div><dt>角色有明确的责任</dt><dd>区分协调、实施与审查，讨论交接如何发生，以及何时应该停下来。</dd></div>
      <div><dt>结论有可以检查的证据</dt><dd>把执行反馈与验收结果分开，用测试和产物回答“是否真的完成”。</dd></div>
    </dl>
  </section>
  {second && <section class="secondary-story shell" aria-labelledby="second-title">
    <div><div class="meta">{second.data.category}<span>示例文章</span></div>
      <h2 id="second-title"><a href={url(`research/${second.id}/`)}>{second.data.title}</a></h2>
      <p>{second.data.description}</p><a class="text-link" href={url(`research/${second.id}/`)}>阅读全文 <span aria-hidden="true">↗</span></a>
    </div>
    <a href={url(`research/${second.id}/`)} tabindex="-1" aria-hidden="true"><img src={url(second.data.image)} srcset={imageSet(second.data.image)} sizes="(max-width: 767px) calc(100vw - 40px), 50vw" alt="" width="1200" height="800" loading="lazy" /></a>
  </section>}
</Base>
